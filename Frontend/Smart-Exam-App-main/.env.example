# Next.js server -> backend API base. Use an address reachable from the
# frontend server/container; localhost is only appropriate on the same host.
# An origin without /api is also accepted. Trailing slashes are normalized.
BACKEND_URL=http://localhost:5221/api

# Browser -> backend origin (NO /api), used for SignalR /hubs/* connections.
# Set a browser-reachable HTTPS origin in production and allow the frontend
# origin in backend CORS. The server-only address above may be different.
NEXT_PUBLIC_BACKEND_URL=http://localhost:5221

# Customer-facing frontend origin (not the API origin and not a /login URL).
# Used for absolute social metadata URLs and notification login-URL guidance.
# Saved notification settings remain authoritative; an unset browser value uses
# the current frontend origin for guidance. Metadata defaults to localhost in dev.
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# NEXT_PUBLIC_* is public and inlined at BUILD TIME by Next.js.
# Set it before `pnpm build`; changing only the runtime environment is not enough.
# Rebuild when either public origin changes, including pre-rendered metadata.
# Never place secrets here.
# Legacy values ending in /api are normalized; an optional reverse-proxy path
# prefix is preserved for both API and hub/static-file paths.
#
# Run the Next.js server (`pnpm start`), not a static export: API/media routes
# require it. Rewrites also capture BACKEND_URL at build time; rebuild when
# changing its media destination. Prefer stable service/DNS names on-prem.
#
# Other existing features may still require external access (MediaPipe model/
# WASM assets, WebRTC STUN/TURN, analytics). This example does not make the
# application offline-ready or configure those backend-managed features.
